# ==============================================================================
# Wallet Platform — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in values
# cp .env.example .env

# --- Database ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet_secret
POSTGRES_DB=wallet_db
DATABASE_URL=postgresql://wallet:wallet_secret@postgres:5432/wallet_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (JWT) ---
# IMPORTANT: Generate real secrets for production!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3002

# --- Environment ---
ENVIRONMENT=development

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
